{
  "name": "helm-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Warranty/RMA intake agent for HELM (AnvilOS) — writes Return/Damage/Adjustment transactions into the HELM schema via API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "agent:run": "tsx src/agent/run.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "zod": "^3.24.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.1",
    "prisma": "7.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
